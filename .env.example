# Neon Postgres (Vercel Marketplace)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Public Vercel Blob store; Vercel adds this automatically after connection.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxx

# Production administrator account
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=pbkdf2-sha256$310000$salt$hash
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
